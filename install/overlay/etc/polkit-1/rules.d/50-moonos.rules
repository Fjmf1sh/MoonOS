// Moon OS: allow the unprivileged shell user ("moon") to do exactly the
// privileged things the console UI needs — nothing else.
polkit.addRule(function(action, subject) {
    if (subject.user != "moon")
        return polkit.Result.NOT_HANDLED;

    // Power menu
    if (action.id == "org.freedesktop.login1.reboot" ||
        action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id == "org.freedesktop.login1.power-off" ||
        action.id == "org.freedesktop.login1.power-off-multiple-sessions")
        return polkit.Result.YES;

    // Wi-Fi management from the Network screen
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0)
        return polkit.Result.YES;

    // Start/restart only the Moon OS units (update, uninstall, devmode,
    // config IO, shell restart) — not arbitrary services.
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit && unit.indexOf("moon-") == 0)
            return polkit.Result.YES;
        return polkit.Result.NOT_HANDLED;
    }

    return polkit.Result.NOT_HANDLED;
});
