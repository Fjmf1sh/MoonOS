[Unit]
Description=Moon Shell (Moon OS console UI)
Documentation=https://github.com/moon-os
After=systemd-user-sessions.service plymouth-start.service dbus.service
Wants=network.target bluetooth.service
Conflicts=getty@tty1.service
# Four crashes in 90 seconds -> stop restarting and bring up recovery
StartLimitIntervalSec=90
StartLimitBurst=4
OnFailure=moon-recovery.service

[Service]
User=moon
Group=moon
# PAMName gives the shell a real logind session on seat0, which grants
# /dev/dri + /dev/input access via device ACLs
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
# Mirror startup output to the FAT boot partition so a black screen is
# self-diagnosing: the file is readable on any Windows/Mac machine.
# truncate = fresh each boot; stderr appends into the same file.
StandardOutput=truncate:/boot/firmware/moon-shell.log
StandardError=append:/boot/firmware/moon-shell.log
SupplementaryGroups=video render input audio bluetooth
Environment=MOONOS_STATE_DIR=/var/lib/moonos
Environment=QT_QPA_EGLFS_HIDECURSOR=1
# Force the KMS modeset so a fresh HDMI link comes up instead of a black CRTC
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=SDL_AUDIODRIVER=alsa
Environment=SDL_GAMECONTROLLERCONFIG_FILE=/usr/share/moonos/gamecontrollerdb.txt
EnvironmentFile=-/etc/moonos/moon.env
# Release the console cleanly before EGLFS takes DRM master. We do NOT use
# --retain-splash: keeping the splash framebuffer can block EGLFS from
# claiming the CRTC on some HDMI sinks (seen as a hang at the splash).
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/lib/moonos/start-shell.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
